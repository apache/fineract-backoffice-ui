# Rendered at container start by deploy/entrypoint.sh, which substitutes exactly three names —
# ${FINERACT_UPSTREAM}, ${FINERACT_PROXY_SSL_VERIFY} and ${FINERACT_FORWARDED_PROTO} — and leaves
# every other `$` alone. nginx runtime variables such as $uri and $host must survive into the
# finished file.

server {
    listen 80;
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    # Security headers.
    #
    # `always` matters: without it nginx omits these on error responses, which is exactly where
    # a reflected payload would land.
    #
    # The CSP has no 'unsafe-eval'. Angular's AOT build does not need it, and admitting it would
    # give any injected string a route to execution. 'unsafe-inline' remains for styles only:
    # Angular emits component styles inline, and there is no nonce plumbed through this static
    # server. Scripts do not get it.
    #
    # `connect-src 'self'` stays, and the /api/ proxy below is what makes it workable. Fineract is
    # reached through this origin, so the browser never makes a cross-origin request and the
    # policy never has to be widened to accommodate one. A deployment that instead points the
    # browser straight at another host has to add that origin here *and* to `allowedApiOrigins`
    # in config.json — deliberately two separate places, so a browser-side setting alone cannot
    # open a new destination.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    # Only honoured over HTTPS; harmless on the plain-HTTP listener and correct once terminated.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Gzip Compression
    gzip on;
    gzip_http_version 1.1;
    gzip_disable      "MSIE [1-6]\.";
    gzip_min_length   256;
    gzip_vary         on;
    gzip_proxied      expired no-cache no-store private auth;
    gzip_types        text/plain text/css application/json application/javascript application/x-javascript text/xml application/xml application/xml+rss text/javascript;
    gzip_comp_level   9;

    # ---------------------------------------------------------------------------------------
    # The Fineract API, same-origin.
    #
    # Without this block the application cannot talk to anything: `config.json` points at
    # `/api/v1`, `try_files` below would answer that with index.html, and every API call would
    # come back as the application's own HTML with a 200. The alternative — pointing the browser
    # at Fineract directly — is refused by the `connect-src 'self'` policy above.
    #
    # Declared before `location /` because nginx matches prefixes longest-first regardless of
    # order, but keeping them adjacent makes the relationship legible.
    # ---------------------------------------------------------------------------------------
    #
    # `^~` is load-bearing: a plain prefix match does not stop nginx evaluating the regex
    # location further down, so an API path ending in .js — and Fineract has them — would be
    # served off the filesystem as a static asset instead of proxied, producing a 404 for a
    # request that should have reached the backend.
    location ^~ /api/ {
        # The trailing slash on both sides strips the `/api` prefix, so a browser request for
        # /api/v1/clients reaches Fineract as <upstream>/v1/clients.
        proxy_pass ${FINERACT_UPSTREAM}/;

        # Fineract is commonly deployed behind the proxy with a self-signed certificate, which is
        # why this defaults to off. Set FINERACT_PROXY_SSL_VERIFY=on once the upstream presents a
        # certificate this container trusts — it should be on in production.
        proxy_ssl_verify ${FINERACT_PROXY_SSL_VERIFY};
        proxy_ssl_server_name on;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;

        # Defaults to `https`, not to $scheme, and that is not an oversight.
        #
        # Fineract decides whether its channel requirement is met from this header. Measured
        # against the stock apache/fineract image, five requests each:
        #
        #   header absent               302 302 302 302 302   Location: https://<host>/...
        #   X-Forwarded-Proto: https    200 200 200 200 200
        #
        # So a container that forwards $scheme works only where TLS is already terminated in
        # front of it, and answers every API call with a redirect anywhere else — which is a
        # container that does not work out of the box. The nginx-to-Fineract hop is itself TLS,
        # so `https` is a true statement about the connection Fineract is answering.
        #
        # Set FINERACT_FORWARDED_PROTO=$scheme if this proxy sits behind another one that
        # already sets the header and you want the original client scheme preserved.
        proxy_set_header X-Forwarded-Proto ${FINERACT_FORWARDED_PROTO};

        # The application sends Authorization and Fineract-Platform-TenantId itself; they pass
        # through untouched. Nothing here adds a credential, and nothing here should.

        # Document upload and bulk import post real files.
        client_max_body_size 64m;

        # Report generation over a large portfolio is slow, and a truncated response reads to the
        # user as a broken screen rather than a slow one.
        proxy_connect_timeout 30s;
        proxy_send_timeout    300s;
        proxy_read_timeout    300s;

        # An API response is never the SPA shell, and must never be cached as one.
        proxy_buffering off;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cache static assets
    location ~* \.(?:ico|css|js|gif|jpe?g|png|woff2?|eot|ttf|svg)$ {
        expires 6M;
        access_log off;
        add_header Cache-Control "public";
    }

    # Error pages
    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
