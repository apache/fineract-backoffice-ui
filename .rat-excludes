# Generated by openapi-generator (npm run generate-api). Every api/ and model/ file carries
# the header from templates/openapi-generator/licenseInfo.mustache; the generator's own
# scaffolding (configuration.ts, encoder.ts, variables.ts and similar) does not, because those
# templates are not overridden. Tracked as an audit finding rather than hidden silently.
src/app/api/
# Release-readiness audit reports and their raw evidence (CSV/txt exports). Documentation
# rather than shipped source, and excluded on the same basis as DOCS/ above.
audit/
